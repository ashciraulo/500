[gd_resource type="Resource" script_class="CarPart" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/vehicle/car_part.gd" id="1_part"]

[resource]
script = ExtResource("1_part")
id = &"roof_surf_rack"
display_name = "Roof rack and surfboard"
description = "A chrome rack with an old single-fin strapped on. Found behind the surf club. Adds a little drag."
slot = &"roof"
modifiers = {"drag_mult": 1.08, "mass_add": 16.0}
