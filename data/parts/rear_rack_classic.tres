[gd_resource type="Resource" script_class="CarPart" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/vehicle/car_part.gd" id="1_part"]

[resource]
script = ExtResource("1_part")
id = &"rear_rack_classic"
display_name = "Engine lid luggage rack"
description = "A chrome rack on the engine lid, the period way to carry a bag. Lets the engine breathe a little warmer."
slot = &"rear_rack"
price = 160
modifiers = {"mass_add": 4.0}
visual = "rack_rear_classic"
fits = PackedStringArray("classic_nuova", "classic_sport", "classic_d", "classic_500f", "classic_500l", "classic_500r", "classic_jolly")
